# Copy to .env.local and fill in. This file is read by .mcp.json, the loader
# and verify_api.sh, so it is the single place credentials live.
# It is sourced by the shell: always quote values, and no spaces around "=".

# 1) Account-level personal access token. Needed NOW, to create the project.
#    https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN="sbp_xxx"

# 2) The three below come AFTER the project exists.
#    Project Settings -> Data API
SUPABASE_URL="https://PROJECT_REF.supabase.co"

#    Project Settings -> API Keys.
#    service_role bypasses RLS: server-side only, never ship it to a browser.
SUPABASE_SERVICE_ROLE_KEY="eyJxxx"

#    anon is safe to expose in the frontend; RLS applies to it.
SUPABASE_ANON_KEY="eyJxxx"
