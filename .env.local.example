# Copy to .env.local and fill in.
#
# ".env.local" is the exact filename everything reads: scripts/supabase_client.py,
# scripts/load_supabase.py, scripts/verify_api.sh and .mcp.json all open it by
# name. A plain .env is NOT read by anything here — do not use one.
#
# Sourced by the shell: always quote values, no spaces around "=".
# .env.local is gitignored and excluded from Vercel. Never commit it.

# ── Also needed as GitHub Actions secrets ───────────────────────────────
# The daily crawl runs on GitHub, not on your machine, so these two must ALSO
# exist as repository secrets, under exactly these names, at
#   Settings -> Secrets and variables -> Actions
# Without them the scheduled crawl never runs and the positioning series on the
# landing page stops growing.

# Project Settings -> Data API. Not secret: it is already in index.html,
# because the browser has to call it.
SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Project Settings -> API Keys -> Legacy API keys -> service_role.
# Bypasses Row Level Security completely: server-side only. Never ship it to a
# browser, never put it in index.html, never commit it.
SUPABASE_SERVICE_ROLE_KEY="eyJxxx"

# ── Local only ──────────────────────────────────────────────────────────

# Account-level personal access token, used by the Supabase MCP server.
# Needed before the project exists, to create it.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN="sbp_xxx"

# Safe to expose in the frontend: RLS applies to it. This is the key embedded
# in index.html.
SUPABASE_ANON_KEY="eyJxxx"

# Newer-style publishable key, same role as the anon key above.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# The bare project ref: the PROJECT_REF in https://PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF="PROJECT_REF"
